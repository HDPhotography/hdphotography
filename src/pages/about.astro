---
import Layout from "../layouts/Layout.astro";

const team = [
  {
    name: "Dinesh",
    role: "Founder and CEO",
    image: "dineshPic.jpg",
    bio: "Dinesh is the creative force and visionary behind HDPhotography. With over a decade of experience behind the lens, he has transformed his lifelong passion for photography into a thriving business. Known for his keen eye, attention to detail, and ability to connect with clients, Dinesh brings both artistry and professionalism to every project. Under his leadership, HDPhotography has grown from a solo venture to a respected studio recognized for its distinctive style and uncompromising quality. Dinesh continues to push creative boundaries while mentoring a new generation of photographers.",
    specialties: ["Wedding Photography", "Portrait Sessions", "Event Coverage"],
  },
  {
    name: "Selva",
    role: "Manager",
    image: "selvaPic.jpeg",
    bio: "Selva plays a vital role at HDPhotography as both the Studio Manager and Lead Photographer. As Dinesh's right hand, Selva oversees day-to-day operations while also leading major photography projects. With a sharp artistic vision and years of experience behind the camera, Selva brings energy, precision, and creativity to every shoot. His ability to handle both creative direction and logistical execution makes him an invaluable part of the HDPhotography team, ensuring every client receives a seamless and exceptional experience.",
    specialties: ["Management", "Creative Photographer", "Leadership"],
  },
  {
    name: "Sanjay",
    role: "Team Lead",
    image: "sanjayPic.jpg",
    bio: "Sanjay is the driving force that keeps the HDPhotography team operating at its best. As the Team Lead, he bridges the gap between creative vision and flawless execution, ensuring that every project meets the studio’s high standards. With a strong background in both photography and post-production, Sanjay brings a unique blend of technical skill and artistic insight to every assignment. He mentors junior photographers, coordinates complex shoots, and streamlines workflows to deliver exceptional results for every client. Known for his calm leadership and innovative approach, Sanjay is instrumental in maintaining the studio’s reputation for excellence and in pushing the creative boundaries of what the team can achieve.",
    specialties: [
      "Team Coordination",
      "Post-Production",
      "Creative Direction",
      "Client Experience",
    ],
  },
];
---

<Layout title="About Us - Professional Photography">
  <main class="">
    <!-- Our Story Section -->
    <section class="py-20 bg-cream dark:bg-gray-900">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center">
          <h1
            class="text-4xl md:text-5xl font-display mb-8 bg-gradient-to-r from-goldLight to-goldDark bg-clip-text text-transparent"
            data-aos="fade-up"
          >
            Our Story
          </h1>
          <div
            class="prose dark:prose-invert mx-auto"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <p class="text-lg text-brown dark:text-gray-300">
              At HD Photography, we don't just take pictures — we freeze time,
              capture emotions, and turn every moment into a timeless story.
              <br /><br />
              \n\n Founded in Chennai, we specialize in wedding photography, blending
              creativity and authenticity to deliver images that truly reflect your
              most cherished memories. Whether it's a traditional wedding, candid
              shoot, or a grand celebration, we ensure every detail is beautifully
              preserved.
            </p>
            <p class="text-lg text-brown dark:text-gray-300 mt-4">
              With a passionate team led by Dinesh, we bring a mix of artistry,
              innovation, and dedication to every project. Our mission is simple
              — to make your special moments unforgettable with high-quality
              photography and a personalized touch.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="py-20 bg-beige dark:bg-gray-800">
      <div class="container mx-auto px-6">
        {
          team.map((member, i) => (
            <div
              class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-20"
              data-aos="fade-up"
              data-aos-delay={i * 100}
            >
              <div class="relative">
                <img
                  src={member.image}
                  alt={member.name}
                  class="rounded-lg shadow-lg border-2 border-goldLight max-w-64 md:max-w-80 w-full h-auto object-cover mx-auto"
                />
              </div>
              <div>
                <h2 class="text-3xl font-display mb-2 text-darkRed dark:text-goldLight">
                  {member.name}
                </h2>
                <p class="text-goldDark font-medium mb-6">{member.role}</p>
                <p class="text-brown dark:text-gray-300 mb-6">{member.bio}</p>
                <div>
                  <h3 class="text-lg font-semibold mb-2 text-darkRed dark:text-goldLight">
                    Specialties:
                  </h3>
                  <ul class="list-disc list-inside text-brown dark:text-gray-300">
                    {member.specialties.map((specialty) => (
                      <li>{specialty}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Awards Section -->
    <section class="py-20 bg-ivory dark:bg-gray-900">
      <div class="container mx-auto px-6">
        <h2
          class="text-4xl font-display text-center mb-12 bg-gradient-to-r from-goldLight to-goldDark bg-clip-text text-transparent"
          data-aos="fade-up"
        >
          Recognition & Awards
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div
            class="text-center p-6 rounded-lg shadow-md bg-champagne dark:bg-gray-800"
            data-aos="fade-up"
          >
            <div class="text-goldDark text-4xl mb-4">🏆</div>
            <h3
              class="text-xl font-semibold mb-2 text-darkRed dark:text-goldLight"
            >
              Best Wedding Photography
            </h3>
            <p class="text-brown dark:text-gray-300">
              Wedding Photography Awards 2023
            </p>
          </div>
          <div
            class="text-center p-6 rounded-lg shadow-md bg-champagne dark:bg-gray-800"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <div class="text-goldDark text-4xl mb-4">🎖️</div>
            <h3
              class="text-xl font-semibold mb-2 text-darkRed dark:text-goldLight"
            >
              Excellence in Portrait Photography
            </h3>
            <p class="text-brown dark:text-gray-300">
              International Portrait Society 2022
            </p>
          </div>
          <div
            class="text-center p-6 rounded-lg shadow-md bg-champagne dark:bg-gray-800"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div class="text-goldDark text-4xl mb-4">🌟</div>
            <h3
              class="text-xl font-semibold mb-2 text-darkRed dark:text-goldLight"
            >
              Top 10 Photography Studios
            </h3>
            <p class="text-brown dark:text-gray-300">
              Professional Photography Magazine 2023
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
